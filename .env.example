PORT=4000

# Supabase (Project settings > API). The service role key stays on the server only.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Long random string, e.g. run: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Your Vercel site. Used for CORS and for the links inside emails.
FRONTEND_URL=http://localhost:3000
# Extra allowed origins, comma separated (optional)
CORS_ORIGINS=

# Brevo (https://app.brevo.com > SMTP & API > API keys)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=GoPath Legal
# The NUMBER of your Brevo contact list (Brevo > Contacts > Lists), for example 3. Not the list name.
BREVO_LIST_ID=
# Where staff alerts go. Can also be changed later in Admin > Settings.
ADMIN_NOTIFY_EMAIL=

# Only used by: npm run create-admin
ADMIN_NAME=Admin
ADMIN_EMAIL=
ADMIN_PASSWORD=
